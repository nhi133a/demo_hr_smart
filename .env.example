# Required database connection
MONGO_URI=

# Embedding provider: local, bedrock, or google
EMBEDDING_PROVIDER=local

# Local embedding options
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBED_BACKEND=sentence_transformer
LOCAL_EMBED_LOCAL_FILES_ONLY=true
LOCAL_EMBED_HASH_FALLBACK=true
LOCAL_EMBED_DIM=384

# Optional cross-encoder reranker for raw JD text + raw CV chunks.
# Keep LOCAL_FILES_ONLY=true for offline demos after the model is cached.
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_LOCAL_FILES_ONLY=true
CROSS_ENCODER_MAX_CHUNKS=6
CROSS_ENCODER_TOP_AVG=3
CROSS_ENCODER_WEIGHT=0.25
REQUIREMENT_EVIDENCE_ENABLED=true
REQUIREMENT_EVIDENCE_THRESHOLD=0.55
REQUIREMENT_EVIDENCE_MAX_REQUIREMENTS=18
REQUIREMENT_EVIDENCE_MAX_CHUNKS=4

# AWS Bedrock options when EMBEDDING_PROVIDER=bedrock
AWS_REGION=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=3000

# Google embedding options when EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=
GOOGLE_EMBED_MODEL=models/embedding-001

# Optional provider currently used by openai_llm.py
OPENAI_API_KEY=
